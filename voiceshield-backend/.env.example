# ============================================================================
# VoiceShield Backend Environment Configuration
# ============================================================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Redis Cache (Redis Cloud or local redis://localhost:6379/0)
REDIS_URL=redis://default:yourredispassword@redis-12345.c123.region.redns.redis-cloud.com:12345

# AI Threat Reasoning Model (Ollama)
# For local host outside Docker: http://localhost:11434/api/generate
# For Docker Compose: http://host.docker.internal:11434/api/generate
# For remote / cloud Ollama server: https://your-ollama-instance.com/api/generate
OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=qwen2.5:1.5b-instruct-q4_0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
